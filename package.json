{
  "name": "hp-rspress",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "export": ".venv/bin/python scripts/export_knowledge.py",
    "dev": "npm run export && rspress dev --host 127.0.0.1 --port 1320",
    "build": "npm run export && rspress build",
    "postbuild": ".venv/bin/python scripts/finalize_markdown.py && npm run check:build",
    "preview": "rspress preview --host 127.0.0.1 --port 1320",
    "test": ".venv/bin/python -m unittest discover -s tests -v && node --test tests/mermaid.test.mjs",
    "check:build": ".venv/bin/python scripts/check_build.py",
    "check:afdocs": ".venv/bin/python scripts/check_afdocs.py"
  },
  "devDependencies": {
    "@rspress/core": "2.0.23",
    "@rspress/plugin-sitemap": "2.0.23",
    "katex": "^0.16.22",
    "pele": "1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-parse": "9.0.1",
    "remark-cjk-friendly": "2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
