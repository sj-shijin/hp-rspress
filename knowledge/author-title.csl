<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>ShiJin — 编号引用与完整参考文献</title>
    <id>https://shijin.space/styles/author-title</id>
    <link href="https://shijin.space/styles/author-title" rel="self"/>
    <category citation-format="numeric"/>
    <updated>2026-10-22T00:00:00+08:00</updated>
  </info>
  <!-- 编号按首次引用顺序分配；页码、章节等定位保留在正文。 -->
  <citation>
    <layout prefix="[" suffix="]" delimiter="; ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography>
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". " suffix=".">
        <names variable="author">
          <name initialize="false" and="text"/>
          <substitute><names variable="editor"/></substitute>
        </names>
        <text variable="title" font-style="italic"/>
        <text variable="container-title"/>
        <date variable="issued"><date-part name="year"/></date>
        <!-- 仅输出一个来源入口；短链接标签由 Pandoc filter 设置。 -->
        <choose>
          <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
          <else><text variable="URL"/></else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
